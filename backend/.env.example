# ==============================================================================
# LectureLens Backend Environment Variables Template
# ==============================================================================
# Copy this file to 'backend/.env' and fill in your values.
# Real environment files are protected and ignored by Git.

# ------------------------------------------------------------------------------
# 1. FastAPI Service Configuration
# ------------------------------------------------------------------------------
PORT=8000

# ------------------------------------------------------------------------------
# 2. CORS Allowed Origins (EXACT ALLOWLIST - COMMA-SEPARATED)
# ------------------------------------------------------------------------------
# Explicit comma-separated list of exact web origins permitted to make requests.
# Wildcard domains (*.netlify.app, *.trycloudflare.com) are disabled for security.
# Default local origins (localhost:5173, 127.0.0.1:5173, localhost:3000) are
# always included automatically.
#
# Examples:
# CORS_ORIGINS=http://localhost:5173,https://lecturelens.netlify.app,https://your-specific-tunnel.trycloudflare.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 3. Local Ollama LLM Inference Engine Configuration
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:0.6b

# ------------------------------------------------------------------------------
# 4. Faster-Whisper Speech-to-Text Engine Configuration
# ------------------------------------------------------------------------------
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ------------------------------------------------------------------------------
# 5. Google Gemini Configuration (Quiz Generation Only)
# ------------------------------------------------------------------------------
# Server-side API key for high-quality MCQ quiz generation
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
