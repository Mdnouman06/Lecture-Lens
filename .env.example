# ==============================================================================
# LectureLens Frontend Environment Variables Template
# ==============================================================================
# Copy this file to '.env.local' or '.env' and fill in your values.
# Real environment files are protected and ignored by Git.

# ------------------------------------------------------------------------------
# 1. AI Bridge Endpoint (PUBLIC CLIENT CONFIGURATION - NOT A SECRET)
# ------------------------------------------------------------------------------
# Options:
# - Local Development: http://localhost:8000 (or http://127.0.0.1:8000)
# - Cloudflare Quick Tunnel: https://your-specific-tunnel.trycloudflare.com
# - Hosted Production Backend: https://api.yourdomain.edu
VITE_API_BASE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 2. Supabase Cloud Configuration (PUBLIC ANON KEY ONLY)
# ------------------------------------------------------------------------------
# Obtain these from your Supabase Dashboard: Project Settings -> API
# NOTE: Only the 'anon' public key is safe for frontend exposure.
# NEVER place your 'service_role' key, database passwords, or private tokens here!
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here
